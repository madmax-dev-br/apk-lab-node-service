{
  "name": "apk-lab-node-service",
  "version": "0.1.0",
  "description": "Run real Android APKs on a Node.js server with the APK Web Lab runtime: a runner service that loads APKs and a queue service that schedules their use.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "fetch-runtime": "node scripts/fetch-runtime.mjs",
    "start:runner": "node services/runner/server.mjs",
    "start:queue": "node services/queue/server.mjs",
    "test": "node --test --test-concurrency=1 test/unit/*.test.mjs test/e2e/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "check": "node scripts/check-repo.mjs"
  }
}
